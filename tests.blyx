use std::cli;
use floorbreach;

fn matches(actual: vector, expected: vector) -> bool {
    if len(actual) != len(expected) { return false; }
    let mut i = 0;
    while i < len(expected) {
        let delta = at(actual, i) - at(expected, i);
        let limit = 0.000000001 + 0.000000001 * at(expected, i) * at(expected, i) / (1.0 + at(expected, i) * at(expected, i));
        if !(delta >= -limit && delta <= limit) { return false; }
        i += 1;
    }
    true
}

fn main() {
    let infinity = 1.0e300 * 1.0e300;
    if !matches(floorbreach_trace(20.0, [-15, -10, 30], 10.0), [0, 2, 15]) { stderr_line("case 1 failed"); process_exit(1); }
    if !matches(floorbreach_trace(0.0, [10], 10.0), [-1, 0, 0]) { stderr_line("case 2 failed"); process_exit(1); }
    if !matches(floorbreach_trace(0.0, [], 10.0), [-1, 0, 0]) { stderr_line("case 3 failed"); process_exit(1); }
    if !matches(floorbreach_trace(infinity, [-15, -10, 30], 10.0), []) { stderr_line("case 4 failed"); process_exit(1); }
    if !matches(floorbreach_trace(20.0, [infinity], 10.0), []) { stderr_line("case 5 failed"); process_exit(1); }
    if !matches(floorbreach_trace(20.0, [-15, -10, 30], infinity), []) { stderr_line("case 6 failed"); process_exit(1); }
    println!("passed");
}
