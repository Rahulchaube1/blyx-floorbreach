use floorbreach;

fn main() {
    let opening = 20.0;
    let flows = [-15, -10, 30];
    let reserve = 10.0;
    let result = floorbreach_trace(opening, flows, reserve);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
